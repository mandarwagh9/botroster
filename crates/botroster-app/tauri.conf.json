{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOTROSTER",
  "version": "0.4.0",
  "identifier": "dev.botroster.botroster",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "BOTROSTER",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
    "externalBin": ["binaries/botroster"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Persistent AI teammates sharing one durable computer",
    "longDescription": "BOTROSTER is the desktop client for botroster: named Bots with conversations that survive the process, one computer they share, and a policy gate that stops anything consequential without permission.",
    "category": "DeveloperTool",
    "copyright": "Apache-2.0",
    "licenseFile": "../../LICENSE"
  }
}
